# All optional. The dashboard works with no keys at all.

# Free key from https://api.congress.gov/sign-up/ — adds latest action on every bill
# and the full list of pending nominations.
CONGRESS_API_KEY=

# --- China alert job (scripts/china-alert.ts) ---
# Public URL of the dashboard, used for links in alerts (e.g. https://capitol-watch.onrender.com)
APP_URL=
# high | medium | low  (default: medium)
ALERT_MIN_LEVEL=medium

# Email via Resend (https://resend.com): comma-separated recipients
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Chat webhooks
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
# Any endpoint that accepts a JSON POST
ALERT_WEBHOOK_URL=
